      "id": "848748b0-295c-48ad-a288-404a125a571c",
      "name": "Loop Over Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        944,
        320
      ]
    },
    {
      "parameters": {
        "url": "={{ String($json.website).startsWith('http') ? $json.website : 'https://' + $json.website }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "id": "3641d8ab-6661-4ddf-85d2-95ef1bbf7bdf",
      "name": "Fetch Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1168,
        448
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst lead = $('Loop Over Leads').item.json;\nconst cfg = $('Config').first().json;\nlet text = String($json.data || '');\ntext = text\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;|&amp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 5000);\n\nconst system = `You are a sales development assistant for ${cfg.senderCompany}.\nWhat we sell: ${cfg.offer}\nIdeal customer profile: ${cfg.icp}\n\nYour job: read the prospect's website text, score how well they fit, and draft a short cold email.\n\nRules:\n- Use ONLY facts found in the website text. Never invent facts, numbers, clients or news.\n- Never state numbers, volumes or staff effort (such as \"thousands of requests\" or \"hours each day\") unless the website text says exactly that.\n- Do not claim how the business operates internally. Say what their website shows, then phrase the likely pain point as a possibility, for example \"I imagine...\" or \"Teams that handle X often find...\".\n- Keep the tone modest and factual: no exaggeration and no \"you currently struggle with\".\n- If the website text is empty or too thin to personalize, score 4 or lower.\n- Score 1-10 for fit with the ideal customer profile.\n- Email body: max 90 words, plain text, no buzzwords, no flattery, no emojis.\n- Structure: one specific observation about their business, one sentence linking it to a problem we likely solve for them, one low-friction question as the call to action.\n- Do not include a greeting, signature, links or unsubscribe text (these are added automatically).\n- Subject: max 6 words, lowercase, no clickbait.\nReturn ONLY valid JSON with no markdown: {\"score\": number, \"reason\": string, \"pain_points\": [string], \"hook\": string, \"subject\": string, \"body\": string}`;\n\nconst user = `Prospect: ${lead.contact_name || 'unknown name'} (${lead.role || 'unknown role'}) at ${lead.company}\nWebsite: ${lead.website}\n\nWebsite text:\n${text || '[website could not be fetched]'}`;\n\nreturn { json: { lead, requestBody: {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { responseMimeType: 'application/json', maxOutputTokens: 3000, temperature: 0.7 }\n} } };\n"
      },
      "id": "7641e1d4-a0cc-4e7c-b70c-276d75b9c943",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        448
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').first().json.model }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "813466c2-63be-44a2-85e7-99f8c4c5d441",
      "name": "AI: Research and Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        448
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst lead = $('Build Prompt').item.json.lead;\nconst cfg = $('Config').first().json;\nlet out = {};\ntry {\n  const raw = $json.candidates[0].content.parts.map(p => p.text || '').join('').replace(/```json|```/g, '').trim();\n  out = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n} catch (e) {\n  out = { score: 0, reason: 'parse_error', hook: '', subject: '', body: '' };\n}\nif (!out.body || !out.subject) { out.score = 0; if (!out.reason) out.reason = 'empty_draft'; }\n\nconst first = String(lead.contact_name || '').trim().split(' ')[0];\nconst greeting = first ? `Hi ${first},` : 'Hi,';\nconst cta = cfg.bookingLink ? `\\n\\nIf easier, grab a time here: ${cfg.bookingLink}` : '';\nconst draft = `${greeting}\\n\\n${out.body}${cta}\\n\\nBest,\\n${cfg.senderName}\\n${cfg.senderCompany}\\n\\nP.S. If this isn't relevant, just reply \"unsubscribe\" and I won't email again.`;\n\nreturn { json: {\n  company: lead.company, website: lead.website, contact_name: lead.contact_name || '',\n  email: String(lead.email || '').trim().toLowerCase(), role: lead.role || '',\n  score: Number(out.score) || 0, reason: out.reason || '', hook: out.hook || '',\n  subject: out.subject || '', draft\n} };\n"
      },

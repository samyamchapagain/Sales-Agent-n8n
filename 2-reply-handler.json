    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst from = String($json.From || ($json.from && $json.from.text) || '');\nconst m = from.match(/<([^>]+)>/);\nconst senderEmail = (m ? m[1] : from).trim().toLowerCase();\nlet body = String($json.text || $json.snippet || '');\nbody = body.split(/\\n>|\\s+On .{5,200}? wrote:/)[0].trim().slice(0, 1500);\nreturn { json: {\n  senderEmail, subject: $json.Subject || $json.subject || '',\n  body, messageId: $json.id, threadId: $json.threadId\n} };\n"
      },
      "id": "1eb63ac9-a044-49e5-9705-7cc010dced7b",
      "name": "Extract Sender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        368
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "PASTE_YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },

          "mode": "name",
          "value": "Leads"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $json.senderEmail }}"
            }
          ]
        },
        "options": {}
      },
      "id": "9d1685cd-5b08-4581-b62a-079b06954471",
      "name": "Find Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        368
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {

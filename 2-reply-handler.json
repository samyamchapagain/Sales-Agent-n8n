    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst lead = $json;\nconst mail = $('Extract Sender').item.json;\nconst cfg = $('Config').first().json;\nconst system = `You handle replies to cold sales emails sent by ${cfg.senderName} of ${cfg.senderCompany}.\nWhat we sell: ${cfg.offer}\n\nClassify the reply into exactly one category:\n- interested: wants to talk, asks for a call, demo or pricing, or says yes\n- question: asks something that needs an answer before deciding\n- not_now: polite no, wrong timing, or asks to be contacted later\n- unsubscribe: asks to stop, remove them, or is hostile\n- other: out-of-office, bounce, auto-reply, unclear or unrelated\n\nAlso write a short plain-text reply (max 70 words, no greeting, no signature):\n- interested: thank them and ${cfg.bookingLink ? 'offer this booking link: ' + cfg.bookingLink : 'ask which days and times this week suit them (do NOT include any link or placeholder)'}\n- question: answer ONLY from the offer description above; if you cannot, say you will get back to them shortly\n- every other category: empty string\nNever invent pricing, features, customers or promises.\nReturn ONLY valid JSON with no markdown: {\"category\": string, \"reply\": string, \"summary\": string}`;\n\nconst user = `Lead: ${lead.contact_name || ''} at ${lead.company}\nOriginal subject: ${lead.subject}\n\nTheir reply:\n${mail.body}`;\n\nreturn { json: { lead, mail, requestBody: {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { responseMimeType: 'application/json', maxOutputTokens: 3000, temperature: 0.7 }\n} } };\n"
      },
      "id": "4d38a0a6-a46d-4de0-9ec7-0e2b707f12f1",
      "name": "Build Reply Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        368
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').first().json.model }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "a443586d-da8d-46f2-b88c-b625ba7dec15",
      "name": "AI: Classify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1168,
        368
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst prev = $('Build Reply Prompt').item.json;\nconst cfg = $('Config').first().json;\nlet out = {};\ntry {\n  const raw = $json.candidates[0].content.parts.map(p => p.text || '').join('').replace(/```json|```/g, '').trim();\n  out = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n} catch (e) {\n  out = { category: 'other', reply: '', summary: 'Could not classify automatically' };\n}\nlet category = ['interested', 'question', 'not_now', 'unsubscribe', 'other'].includes(out.category) ? out.category : 'other';\n// Without autoSend, a human reviews every reply that would be sent.\nif (!cfg.autoSend && category === 'interested') category = 'question';\n\nconst statusMap = { interested: 'interested', question: 'needs_review', not_now: 'follow_up_later', unsubscribe: 'do_not_contact', other: 'needs_review' };\nconst first = String(prev.lead.contact_name || '').trim().split(' ')[0];\nconst reply = String(out.reply || '').trim();\nconst replyText = reply ? `${first ? 'Hi ' + first + ',' : 'Hi,'}\\n\\n${reply}\\n\\nBest,\\n${cfg.senderName}\\n${cfg.senderCompany}` : '';\n\nreturn { json: {\n  email: prev.lead.email, company: prev.lead.company, category,\n  newStatus: statusMap[category], summary: out.summary || '',\n  reply, replyText, theirReply: prev.mail.body, messageId: prev.mail.messageId\n} };\n"
      },

{
  "name": "Sales Agent 3 - Follow-ups",
  "nodes": [
    {
      "parameters": {
        "content": "## Sales Agent 3: Follow-ups\n\nRuns weekdays at 10:00. Finds leads with status `contacted`, no reply after `followUpDays` days and fewer than `maxFollowUps` follow-ups, then writes and sends a short follow-up in the same thread.\n\nWith `autoSend` = false it saves a Gmail draft instead.",
        "height": 240,
        "width": 440
      },
      "id": "57b83002-b7d3-44e2-b1e9-ca204e474dfa",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",

    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst now = Date.now();\nreturn $input.all().filter(i => {\n  const r = i.json;\n  if (!r.email || !r.message_id || !r.last_contacted) return false;\n  const days = (now - new Date(r.last_contacted).getTime()) / 86400000;\n  return days >= cfg.followUpDays && Number(r.follow_ups || 0) < cfg.maxFollowUps;\n});\n"
      },
      "id": "f396403e-062a-4d28-be69-ed1942551a28",
      "name": "Due for Follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        320
      ]
    },
    {
      "parameters": {
        "maxItems": "={{ $('Config').first().json.dailyLimit }}"
      },
      "id": "b9a6e58e-746c-4f39-8eb4-c7ae7aba3959",
      "name": "Daily Cap",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        944,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst lead = $json;\nconst cfg = $('Config').first().json;\nconst n = Number(lead.follow_ups || 0) + 1;\nconst isLast = n >= cfg.maxFollowUps;\nconst system = `You write short follow-up emails for ${cfg.senderName} of ${cfg.senderCompany}.\nWhat we sell: ${cfg.offer}\n\nWrite follow-up number ${n} to a prospect who has not replied.\nRules:\n- Max 50 words, plain text, no greeting, no signature, no links.\n- Do not guilt-trip or say \"just checking in\" or \"bumping this\".\n- Offer one new angle or one useful, specific thought connected to their business hook. Do not repeat the first email.\n${isLast ? '- This is the final follow-up: say it is the last note and leave the door open.' : ''}\nReturn ONLY valid JSON with no markdown: {\"body\": string}`;\n\nconst user = `Prospect: ${lead.contact_name || ''} at ${lead.company}\nHook from first email: ${lead.hook || 'n/a'}\nFirst email subject: ${lead.subject}`;\n\nreturn { json: { lead, requestBody: {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { responseMimeType: 'application/json', maxOutputTokens: 3000, temperature: 0.7 }\n} } };\n"
      },
      "id": "fd77fa10-ac6f-4d1f-955a-e8f0dea67d2d",
      "name": "Build Follow-up Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').first().json.model }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 90000
        }
      },
      "id": "bd36f8f3-ff4d-4806-a13a-a70b780ef87b",
      "name": "AI: Write Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1392,
        320
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Gemini API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst lead = $('Build Follow-up Prompt').item.json.lead;\nconst cfg = $('Config').first().json;\nlet body = '';\ntry {\n  const raw = $json.candidates[0].content.parts.map(p => p.text || '').join('').replace(/```json|```/g, '').trim();\n  body = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1)).body || '';\n} catch (e) { body = ''; }\n// If the model failed, skip this lead for now (empty text is filtered out below).\nconst first = String(lead.contact_name || '').trim().split(' ')[0];\nconst text = body ? `${first ? 'Hi ' + first + ',' : 'Hi,'}\\n\\n${body}\\n\\nBest,\\n${cfg.senderName}\\n${cfg.senderCompany}\\n\\nP.S. Reply \"unsubscribe\" and I won't email again.` : '';\nreturn { json: {\n  email: lead.email, company: lead.company, subject: 'Re: ' + (lead.subject || ''),\n  messageId: lead.message_id, threadId: lead.thread_id,\n  followUps: Number(lead.follow_ups || 0) + 1, text\n} };\n"
      },
